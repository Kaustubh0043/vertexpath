{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "worker.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "API",
      "service": "pathpilot-api"
    }
  ]
}
